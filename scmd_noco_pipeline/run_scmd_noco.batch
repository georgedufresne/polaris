#!/bin/bash -l
#SBATCH --job-name=scmd_noco
#SBATCH --output=/dartfs-hpc/scratch/f007058/scmd_noco_pipeline/logs/%A_%a.out
#SBATCH --error=/dartfs-hpc/scratch/f007058/scmd_noco_pipeline/logs/%A_%a.err
#SBATCH --mem=3G
#SBATCH --time=48:00:00
#SBATCH --account=physics
#SBATCH --ntasks=1
#SBATCH --cpus-per-task=1
#SBATCH --nodes=1
#SBATCH --array=0-991%432
#SBATCH --mail-user=george.e.dufresne.gr@dartmouth.edu
#SBATCH --mail-type=FAIL

module load python/anaconda3
source $(conda info --base)/etc/profile.d/conda.sh
conda activate fidanka-env

W=/dartfs-hpc/scratch/f007058/scmd_noco_pipeline
cd $W

# map array index -> run number from the staged isochrone list
ID=$(sed -n "$((SLURM_ARRAY_TASK_ID + 1))p" $W/runs.txt)
echo "task $SLURM_ARRAY_TASK_ID -> run $ID   start $(date '+%F %T')"

for AGE in $(seq 4.0 0.1 12.0); do
    python scmd_grid_red_dist_chaboyer_g_err_3err_test_noco.py $ID $AGE
    python kde_code_for_grid_best_match_chaboyer_test_noco.py  $ID $AGE
done

python 2d_ks_comparison_grid_chaboyer_kde_noco.py $ID
echo "done $(date '+%F %T')"
