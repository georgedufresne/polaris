#!/bin/bash
#SBATCH --job-name=feh_test
#SBATCH --account=physics
#SBATCH --partition=standard
#SBATCH --cpus-per-task=4
#SBATCH --mem=8G
#SBATCH --time=04:00:00
#SBATCH --output=/dartfs-hpc/scratch/f007058/emul_W14/feh_convention/logs/feh_test_%A_%a.out
# W v1.4 [Fe/H] convention test (feh_test.py) on the 36 runs of ../flow_noise/runs.txt; task i takes every n-th run.
#   sbatch --array=0-11 feh_test.batch
F=/dartfs-hpc/scratch/f007058/emul_W14/feh_convention
PY=${PY:-/dartfs-hpc/rc/home/8/f007058/.conda/envs/fidanka-env/bin/python}   # needs torch 2.8.0 + zuko 1.2.0
NT=${SLURM_ARRAY_TASK_COUNT:-1}; I=${SLURM_ARRAY_TASK_ID:-0}
RUNS=$(awk -v n=$NT -v i=$I '(NR-1) % n == i' $F/runs.txt | tr '\n' ' ')
echo "task $I runs: $RUNS  $(date '+%F %T')"
$PY $F/feh_test.py $RUNS
echo "done $(date '+%F %T')"
