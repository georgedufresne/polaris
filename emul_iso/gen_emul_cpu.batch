#!/bin/bash -l
#SBATCH --job-name=emul_cpu
#SBATCH --output=/dartfs-hpc/scratch/f007058/emul_iso/logs/%A_%a.out
#SBATCH --error=/dartfs-hpc/scratch/f007058/emul_iso/logs/%A_%a.err
#SBATCH --mem=8G
#SBATCH --time=04:00:00
#SBATCH --account=physics
#SBATCH --cpus-per-task=4
#SBATCH --nodes=1
#SBATCH --array=0-49%50
source /optnfs/common/miniconda3/etc/profile.d/conda.sh
conda activate fidanka-env
export PYTHONPATH=/dartfs-hpc/rc/home/8/f007058/CONF1DENCE OMP_NUM_THREADS=4
START=$(( 20000 + SLURM_ARRAY_TASK_ID * 20 ))
echo "task $SLURM_ARRAY_TASK_ID -> runs $START..$((START+19))  $(date '+%F %T')"
python3 /dartfs-hpc/scratch/f007058/emul_iso/gen_emul_iso.py $(seq $START $((START+19))) \
    --device cpu --n-mass 600 --mass-low 0.25 --mass-high 1.60
echo "done $(date '+%F %T')"
